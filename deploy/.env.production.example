# Production configuration for deploy/docker-compose.prod.yml.
#   cp deploy/.env.production.example deploy/.env.production
# Fill in every value marked REQUIRED; compose refuses to start without them.
# Keep the real file out of git (it is ignored) and readable only by you:
#   chmod 600 deploy/.env.production

# --- Site ---------------------------------------------------------------------
# REQUIRED. Public hostname; must resolve to this server. Caddy obtains the TLS
# certificate for it automatically.
SITE_DOMAIN=
# REQUIRED. Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# --- Secrets (REQUIRED) ---------------------------------------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
OPS_TOKEN=
POSTGRES_PASSWORD=

# --- Database -------------------------------------------------------------------
POSTGRES_DB=truth_of_fun
POSTGRES_USER=truth_of_fun
# Days of nightly dumps kept in deploy/backups (copy them off-host).
BACKUP_KEEP_DAYS=14

# --- API ------------------------------------------------------------------------
# uvicorn worker processes. Rate limits are shared through Redis, so >1 is safe.
API_WORKERS=2

# --- Geocoding (REQUIRED) -------------------------------------------------------
# Nominatim's usage policy requires a User-Agent that identifies the
# application and a way to reach you. Example:
#   truth-of-fun/1.0 (https://your-domain.example; ops@your-domain.example)
GEOCODING_USER_AGENT=
GEOCODING_PROVIDER=nominatim

# --- Alerts and error reporting (strongly recommended) ----------------------------
# Slack- or Discord-compatible webhook for ingestion alerts.
ALERT_WEBHOOK_URL=
# Sentry DSN for API and worker exceptions. Unset disables reporting.
SENTRY_DSN=

# --- Email (needed for password resets) -------------------------------------------
# Any SMTP provider (SES, Postmark, Mailgun, Resend, a Workspace relay). With
# SMTP_HOST unset, reset requests are accepted but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Sources (each optional; blank disables that source or feature) ---------------
TICKETMASTER_API_KEY=
ANTHROPIC_API_KEY=
MEETUP_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Proxy for the browser-driven scrapers, if their sites block your host.
PROXY_URL=
