# Where the BROWSER reaches the API. Inlined at build time.
# Local development talks to FastAPI directly; production builds use the
# same-origin path "/api" (see apps/web/Dockerfile).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public origin of the site, used for canonical links, share cards, robots.txt
# and sitemap.xml. Inlined at build time. Required in production (the fallback
# is http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=https://example.com

# Where the Next.js SERVER reaches the API (event pages, share metadata,
# sitemap). Read at runtime. Needed whenever NEXT_PUBLIC_API_BASE_URL is
# relative, e.g. http://api:8000 inside a compose network.
# API_INTERNAL_URL=http://127.0.0.1:8000
