# Production image for the Next.js web app (standalone output).
#
# Build from the repository root so the npm workspace (apps/web +
# packages/api-client) resolves:
#
#   docker build -f apps/web/Dockerfile -t truth-of-fun-web .
#
# NEXT_PUBLIC_API_BASE_URL is inlined into the browser bundle at build time.
# The default "/api" assumes the reverse proxy serves the API under the same
# origin (see deploy/Caddyfile), which makes one image valid for every
# environment and removes CORS from the request path. Pass an absolute URL
# only when the API lives on a different origin.
FROM node:22-slim AS build

WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/mcp-server/package.json packages/mcp-server/package.json
# The api-client workspace compiles itself in its "prepare" script, which npm
# runs during install even with --ignore-scripts, so its sources have to be
# present before `npm ci` (it is small; the web sources stay in a later layer).
COPY packages/api-client packages/api-client
RUN npm ci

COPY apps/web apps/web

ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_SITE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN npm run web:build

FROM node:22-slim AS web

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /srv
# The standalone tree mirrors the monorepo layout; static assets are not
# traced into it and have to be copied alongside server.js. (The app has no
# public/ directory — icons and robots are generated by app/ routes.)
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static

USER node
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
